# Smart Intercom Default Configuration
# ESP32-C6 Target

# Target
CONFIG_IDF_TARGET="esp32c6"

# Partition Table
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# FreeRTOS - 1000Hz tick rate for precise timing
CONFIG_FREERTOS_HZ=1000

# WiFi Configuration
CONFIG_ESP_WIFI_MODE_STA=y
CONFIG_ESP_WIFI_SCAN_RSSI_THRESHOLD=-127
CONFIG_ESP_WIFI_AUTH_WPA2_PSK=y

# HTTP Server
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_MAX_URI_LEN=512

# Logging - Info level by default
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_DEFAULT_LEVEL=3

# Watchdog
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10

# Power Management (disabled for stable operation)
CONFIG_PM_ENABLE=n

# Stack sizes
CONFIG_ESP_MAIN_TASK_STACK_SIZE=4096
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=2304

# GPIO
CONFIG_GPIO_CTRL_FUNC_IN_IRAM=y



