CONFIG_IDF_TARGET="esp32c6"

# Disable OpenThread (using WiFi instead)
CONFIG_OPENTHREAD_ENABLED=n

# Disable lwip ipv6 autoconfig
CONFIG_LWIP_IPV6_AUTOCONFIG=n

# LwIP config for OpenThread
CONFIG_LWIP_IPV6_NUM_ADDRESSES=8
CONFIG_LWIP_MULTICAST_PING=y

# MDNS platform
CONFIG_USE_MINIMAL_MDNS=n

# Enable WiFi for commissioning (more reliable than Thread-only)
CONFIG_ENABLE_WIFI_STATION=y

# Enable chip shell for debugging commands
CONFIG_ENABLE_CHIP_SHELL=y

# BLE Sleep - DISABLED for stability during commissioning
CONFIG_BT_LE_SLEEP_ENABLE=n
CONFIG_BT_LE_LP_CLK_SRC_MAIN_XTAL=y

# Disable external 32K crystal
CONFIG_RTC_CLK_SRC_EXT_CRYS=n

# Power management - DISABLED for stability
CONFIG_PM_ENABLE=n

# FreeRTOS config
CONFIG_FREERTOS_HZ=1000

# IEEE 802.15.4 disabled (WiFi mode)
CONFIG_IEEE802154_SLEEP_ENABLE=n

# Enable IPv4 and ND6 for WiFi support
CONFIG_LWIP_ND6=y
CONFIG_LWIP_IPV4=y
CONFIG_DISABLE_IPV4=n

# Disable hardware acceleration
CONFIG_MBEDTLS_HARDWARE_AES=n
CONFIG_MBEDTLS_HARDWARE_MPI=n
CONFIG_MBEDTLS_HARDWARE_SHA=n
CONFIG_MBEDTLS_HARDWARE_ECC=n
CONFIG_MBEDTLS_HARDWARE_ECDSA_VERIFY=n
CONFIG_MBEDTLS_SSL_PROTO_DTLS=y

# Thread disabled (using WiFi)

# ICD configurations - disabled for door intercom (needs to be always responsive)
CONFIG_ENABLE_ICD_SERVER=n
