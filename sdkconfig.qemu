# Smart Intercom QEMU Configuration
# Overrides for emulation environment

# Include defaults
CONFIG_IDF_TARGET="esp32c6"

# Partition Table
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# FreeRTOS
CONFIG_FREERTOS_HZ=1000

# Disable WiFi for QEMU (use host networking)
CONFIG_ESP_WIFI_MODE_STA=n

# HTTP Server
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_MAX_URI_LEN=512

# Verbose logging for debugging in QEMU
CONFIG_LOG_DEFAULT_LEVEL_DEBUG=y
CONFIG_LOG_DEFAULT_LEVEL=4

# Watchdog - longer timeout for QEMU
CONFIG_ESP_TASK_WDT_TIMEOUT_S=30

# Stack sizes
CONFIG_ESP_MAIN_TASK_STACK_SIZE=4096
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=2304

# GPIO in IRAM
CONFIG_GPIO_CTRL_FUNC_IN_IRAM=y

# QEMU-specific: Disable hardware that doesn't emulate well
CONFIG_ESP_CONSOLE_UART_DEFAULT=y

